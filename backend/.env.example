NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database configuration
MONGODB_URI=mongodb://localhost:27017/codemind
JWT_SECRET=super_secret_codemind_development_jwt_key_32chars!
JWT_EXPIRES_IN=7d

# Google Gemini API configuration
# Provide your Google Gemini API key below:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# GitHub Personal Access Token (optional, for higher rate limits & private repos)
GITHUB_TOKEN=

# Redis & Queue configuration
# If REDIS_URL is not provided or reachable, the backend gracefully falls back to direct async worker execution.
REDIS_URL=redis://localhost:6379

# Vector Provider: mongodb_atlas | memory | qdrant
VECTOR_PROVIDER=memory
QDRANT_URL=
QDRANT_API_KEY=

# File upload limits and storage directories
UPLOAD_DIR=uploads
TEMP_DIR=temp
REPORT_DIR=reports

MAX_UPLOAD_SIZE_MB=50
MAX_EXTRACTED_SIZE_MB=200
MAX_FILES_PER_REPOSITORY=5000
MAX_ANALYSIS_BATCH_SIZE=10

# AI Limits & Timeout
AI_MAX_RETRIES=3
AI_REQUEST_TIMEOUT_MS=60000

# Security & CORS
COOKIE_SECRET=codemind_cookie_secret_99887766!
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

