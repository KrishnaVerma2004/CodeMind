{
  "name": "codemind-ai",
  "version": "1.0.0",
  "description": "CodeMind AI - AI-Powered Software Intelligence & Codebase Understanding Platform",
  "private": true,
  "workspaces": [
    "backend",
    "worker",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm --workspace=backend run dev",
    "dev:worker": "npm --workspace=worker run dev",
    "dev:frontend": "npm --workspace=frontend run dev",
